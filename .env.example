# cp .env.example .env

# Jobs DB (async job statuses)
# Local uvicorn:
JOB_DATABASE_URL=mysql+aiomysql://integrity:integrity@localhost:3307/jobs
# Docker Compose (service mysql-jobs):
# JOB_DATABASE_URL=mysql+aiomysql://integrity:integrity@mysql-jobs:3306/jobs

# Docker Compose — optional host ports (defaults in docker-compose.yml)
# API_PORT=8000
# MYSQL_JOBS_PORT=3307

# Database profiles for projects: app/config/environments.yaml
# Docker API: project=adventure, env=docker
